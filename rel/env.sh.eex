#!/bin/sh
# Sourced by bin/ticketing before the release starts (and before `remote`/`rpc`).

# Long names (name@host) so nodes on different machines can reach each other.
export RELEASE_DISTRIBUTION=name

# Name each node after its own IP: ticketing@10.0.1.12. DNSCluster looks up the
# `ticketing` DNS name, gets every IP back and connects to ticketing@<ip>, so
# the part before the @ must be the same on every node.
export RELEASE_NODE=ticketing@$(hostname -i | awk '{print $1}')

# RELEASE_COOKIE comes from the environment (docker-compose.yml passes one).
# Every node needs the same cookie to connect. In real life use a long random
# value from your secret store, e.g. `openssl rand -base64 48`.
# The cookie is NOT security: it stops accidents, not attackers. See the
# "Security" section of the README.

# --- Hardening (opt-in) ------------------------------------------------------
# Uncomment to lock distribution down. Only for the running node, not for the
# short-lived `remote`/`rpc` nodes, which need their own random port.
#
# case $RELEASE_COMMAND in
#   start*|daemon*)
#     IP_TUPLE=$(hostname -i | awk '{print $1}' | tr . ,)
#     # epmd (port 4369) listens only on the private interface.
#     export ERL_EPMD_ADDRESS=$(hostname -i | awk '{print $1}')
#     # Distribution listens on one fixed port, on the private interface only,
#     # so a firewall rule can allow exactly 4369 + 9100 between nodes.
#     export ELIXIR_ERL_OPTIONS="-kernel inet_dist_use_interface {$IP_TUPLE} -kernel inet_dist_listen_min 9100 -kernel inet_dist_listen_max 9100"
#     # Or encrypt distribution with TLS (needs certs, see the README):
#     # export ELIXIR_ERL_OPTIONS="$ELIXIR_ERL_OPTIONS -proto_dist inet_tls -ssl_dist_optfile /app/ssl_dist.conf"
#     ;;
# esac
